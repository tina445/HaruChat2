DerivedData/

# Native build output
/native/build/
/native/out/
/native/probe/Vendor/
/native/probe/out/

# xcross Flutter native probe generated/imported inputs
/flutter/xcross_native_probe/packages/hc_llm_flutter/ios/hc_llm_flutter/Vendor/
# Legacy import path used before plugin staging was accounted for.
/flutter/xcross_native_probe/vendor/
/flutter/xcross_native_probe/.dart_tool/
/flutter/xcross_native_probe/build/
/flutter/xcross_native_probe/.flutter-plugins*
# Flutter generates the remaining iOS/Flutter files, but assemble requires this
# stable template input on every host (including xcross).
/flutter/xcross_native_probe/ios/Flutter/*
!/flutter/xcross_native_probe/ios/Flutter/AppFrameworkInfo.plist
/flutter/xcross_native_probe/ios/Runner/GeneratedPluginRegistrant.*

